# DUB- keys — copy to .env and fill in what you use. NEVER commit .env.
#
# Local runs read these from the environment automatically.
# GitHub Actions runs read them from repo Secrets (push them with
# scripts/set_secrets.sh).

# ElevenLabs (cloud cloning + TTS) — https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# Minimax via fal.ai (cloud cloning + TTS) — https://fal.ai/dashboard/keys
FAL_KEY=

# Accept the Coqui Public Model License for XTTS v2 (local engine)
COQUI_TOS_AGREED=1
