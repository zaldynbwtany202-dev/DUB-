      "tempo": 1.0800915331807728,
      "fitted_seconds": 1.1115833333333334,
      "text": "مصدومة.",
      "speech_truncated": false,
      "leading_silence_removed": 0.17,
      "trailing_silence_removed": 0.0
    },
    {
      "index": 4,
