+    mc = chain_air_evidence(shaped + _air(rng, AIR_DBFS + 9.0), shaped, PLAN, SR, AIR_DBFS)
+    assert master_chain_gate(mc) is False
+    assert abs(mc["air_level_error_db"]) > 4.0
