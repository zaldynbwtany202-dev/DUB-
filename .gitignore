# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
*.egg
.venv/
.mypy_cache/
.ruff_cache/

# Project runtime
.cache/
temp/
output/
uploads/
inbox/*
!inbox/.gitkeep
.local/
samples/*.wav
*.mp4
*.wav
*.mp3
*.srt
!samples/*.mp4
!samples/*.srt
!samples/*.png
# Approved studio voice takes are shipped assets, not scratch audio.
!samples/voices/
!samples/voices/*.mp3
!samples/voices/*.json
*.webm
*.mkv

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Dub projects: keep the recipe and deliverables, drop scratch and source media.
projects/*/work/
projects/*/source/
!projects/*/output/
!projects/*/voices/
!projects/*/project.json
!projects/*/voices/*.wav
!projects/*/output/*.mp4
!projects/*/output/*.srt

# GitHub Pages assets: the page serves these from beside itself, so the broad
# *.mp4 / *.srt rules must not swallow them.
!docs/*.mp4
!docs/*.srt
!docs/*.vtt
# Voice audition clips. The directory has to be unignored before the files
# inside it can be: git will not look inside an excluded directory, so listing
# only "!docs/samples/*.mp3" silently keeps them all out.
!docs/samples/
!docs/samples/*.mp3

# Smart-dub runtime state lives in the checkpoint release, never in git.
checkpoints/
voice-audit/

# Studio library: one folder per video (sources, possibly split in parts) and
# one folder per dubbed video. Both are deliverables, not scratch.
!library/
!library/**
!dubs/
!dubs/**

# generated A/B listening files (rebuild: python scripts/verify_voice.py --ab FILE)
.preview/ab/

# Intake by the preview server: a source bigger than GitHub's 100 MB blob limit
# is committed as parts under library/<slug>/parts/, and the assembled copy stays
# local as *.local.* (rebuild it with scripts/join_parts.py). In-flight slices
# live in .parts/ and are joined and deleted on finish.
library/*/*.local.*
library/*/.parts/

# Recorded dub takes are shipped assets, not scratch audio. Synthesis is the
# slowest and most rate-limited step in the pipeline, so a take that is lost
# has to be paid for again at ten clips per turn. Keep the takes alongside the
# plan they were recorded from.
!work/*/takes/*.mp3
# Separated stems likewise. The blanket *.mp3 rule above silently dropped an
# entire separation: the checkpoints committed their index and nothing else, so
# seventy minutes of inference vanished three times over and had to be redone
# each time. Stems are inputs to mixing, not scratch.
!work/*/stems/*.mp3
# Previews are what the user is asked to judge. Losing one means asking them to
# listen to something again that they have already listened to, and the build
# behind it may not be reproducible.
!previews/*.mp4
